<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>AI Calorie Coach</string>
	<key>NSCameraUsageDescription</key>
	<string>AI Calorie Coach uses your camera to photograph food so we can estimate its nutritional content using AI.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AI Calorie Coach accesses your photo library so you can select a food photo for AI-powered calorie analysis.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UISupportsDocumentBrowser</key>
	<false/>
	<!--
	  Google Sign-In requires the reversed OAuth client ID as a URL scheme.
	  After downloading the GoogleService-Info.plist with iOS Sign-In enabled,
	  copy the REVERSED_CLIENT_ID value into the string below.
	  See backend/README.md → "Google Cloud setup" for the exact steps.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.807908453055-bt3p1mjlsi702sj2ci19ssfum1qus4dj</string>
			</array>
		</dict>
	</array>
	<key>BackendBaseURL</key>
	<string>$(BACKEND_BASE_URL)</string>
</dict>
</plist>
